<?xml version="1.0" encoding="utf-8"?>
<!-- One line of the scores panel: the status (minute, time, "Final"), then the home crest, the game and
     the away crest (an F1 line: the driver's flag before the name). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:background="@drawable/input_row_bg"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:singleLine="true"
        android:textColor="@drawable/pill_text_dim"
        android:textSize="15sp" />

    <ImageView
        android:id="@+id/leadLogo"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="12dp"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <TextView
        android:id="@+id/game"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:maxWidth="1100dp"
        android:singleLine="true"
        android:textColor="@drawable/pill_text"
        android:textSize="20sp" />

    <ImageView
        android:id="@+id/trailLogo"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="12dp"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no"
        android:visibility="gone" />
</LinearLayout>
