<?xml version="1.0" encoding="utf-8"?>
<!-- Window changes of every app (to keep Google TV Home's home activity off screen, to leave the
     Assistant's results it shows, and to know when the viewer left them), global actions and key
     filtering for the Home key (every other key is handed straight back; Back is only looked at). Of
     window content only the active window's package name is read (QuickPanelService.checkFront), for
     the moments no window change announces Google TV Home: boot, an update, the screen waking. Key
     filtering depends only on flagRequestFilterKeyEvents and canRequestFilterKeyEvents, not on the
     event types. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="0"
    android:description="@string/quick_panel_description" />
